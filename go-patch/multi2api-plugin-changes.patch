+// catalog 返回上游动态模型表（带缓存）。force=true 时强制刷新。
+func (h *Handler) catalog(force bool) ([]provider.ModelInfo, error) {
+	h.modelsMu.RLock()
+	if !force && len(h.modelsList) > 0 && time.Since(h.modelsAt) < modelsCacheTTL {
+		list := h.modelsList
+		h.modelsMu.RUnlock()
+		return list, nil
+	}
+	h.modelsMu.RUnlock()
+
+	h.modelsMu.Lock()
+	defer h.modelsMu.Unlock()
+	// 双检：可能已被并发请求刷新。
+	if !force && len(h.modelsList) > 0 && time.Since(h.modelsAt) < modelsCacheTTL {
+		return h.modelsList, nil
+	}
+
+	// 按平台分组，每个平台取一个账号，合并其模型表（按 ID 去重，先到先得）。
+	seen := map[string]bool{}
+	merged := make([]provider.ModelInfo, 0, 32)
+	var firstErr error
+	for _, platform := range catalogPlatformOrder {
+		p := h.cfg.Providers[platform]
+		if p == nil {
+			continue
+		}
+		var acct *auth.Auth
+		for _, st := range h.cfg.Pool.List() {
+			if st.Platform != platform {
+				continue
+			}
+			if a := h.cfg.Pool.AuthByKey(st.Key); a != nil {
+				acct = a
+				break
+			}
+		}
+		if acct == nil {
+			continue
+		}
+		infos, err := p.FetchModels(acct)
+		if err != nil {
+			if firstErr == nil {
+				firstErr = fmt.Errorf("%s: %w", platform, err)
+			}
+			continue
+		}
+		for _, info := range infos {
+			if info.ID == "" || seen[info.ID] {
+				continue
+			}
+			seen[info.ID] = true
+			merged = append(merged, info)
+		}
+	}
+	if len(merged) == 0 {
+		h.modelsErr = firstErr
+		return nil, firstErr
+	}
+	h.modelsList = merged
+	h.modelsAt = time.Now()
+	h.modelsErr = nil
+	return merged, nil
+}
+
+// modelUpstream 在动态表中查模型 ID（大小写不敏感），返回上游模型名。
+func (h *Handler) modelUpstream(list []provider.ModelInfo, model string) (string, bool) {
+	for _, info := range list {
+		if strings.EqualFold(info.ID, model) {
